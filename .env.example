# ==============================================================================
# TaskForge Environment Configuration Template
# ==============================================================================
# Note: Copy this file to .env and configure the appropriate values.
# NEVER commit real credentials to version control.
# ==============================================================================

# Application Configuration
APP_ENV=development
APP_NAME=TaskForge
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Supabase Auth & Database
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
SUPABASE_DB_URL=postgresql+asyncpg://postgres:your-db-password@db.your-project.supabase.co:5432/postgres
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Queue Configuration (pgmq or table-queue fallback)
QUEUE_NAME=taskforge_jobs
QUEUE_TYPE=auto
QUEUE_POLL_INTERVAL_SECONDS=2.0
QUEUE_VISIBILITY_TIMEOUT_SECONDS=60

# Worker Configuration
WORKER_ID=worker-node-1
WORKER_CONCURRENCY=4
WORKER_HEARTBEAT_INTERVAL_SECONDS=15
JOB_DEFAULT_TIMEOUT_SECONDS=300
JOB_DEFAULT_MAX_ATTEMPTS=5
RETRY_BASE_DELAY_SECONDS=2.0
RETRY_MAX_DELAY_SECONDS=60.0

# Elasticsearch Observability
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_INDEX_PREFIX=taskforge-logs
ELASTICSEARCH_ENABLED=false

# AI Failure Investigation (CrewAI / LLM)
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
